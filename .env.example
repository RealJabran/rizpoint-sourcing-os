# Copy to .env for Docker Compose. Use development-only placeholder values.
POSTGRES_DB=rizpoint
POSTGRES_USER=rizpoint
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://rizpoint:replace-with-local-password@postgres:5432/rizpoint?schema=public
REDIS_URL=redis://redis:6379
SCANNER_BASE_URL=http://scanner:8000
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=rizpoint-private
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
MINIO_ROOT_USER=replace-with-local-access-key
MINIO_ROOT_PASSWORD=replace-with-local-secret-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
