# Copy to .env for Docker Compose. Use development-only placeholder values.
POSTGRES_DB=rizpoint
POSTGRES_USER=rizpoint
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://rizpoint:replace-with-local-password@postgres:5432/rizpoint?schema=public
REDIS_URL=redis://redis:6379
SCANNER_BASE_URL=http://scanner:8000
S3_ENDPOINT=http://minio:9000
# Public, non-secret origin used only for browser presigned PUT/GET and CSP.
S3_PUBLIC_ENDPOINT=http://localhost:9000
MALWARE_SCAN_MODE=clamav
CLAMAV_HOST=clamav
S3_REGION=us-east-1
S3_BUCKET=rizpoint-private
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=
S3_VERSIONING_ENABLED=false
S3_LIFECYCLE_MANAGED=false
MINIO_ROOT_USER=replace-with-local-access-key
MINIO_ROOT_PASSWORD=replace-with-local-secret-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local Compose only. Production must set RIZPOINT_PRIVATE_MODE=true and false here.
PHASE_ZERO_DEMO_MODE=true
RIZPOINT_ALLOW_UNAUTHENTICATED_DEMO=true
RIZPOINT_PRIVATE_MODE=false
RIZPOINT_PRIVATE_ORGANIZATION_SLUG=rizpoint-private
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-server-side-characters
RIZPOINT_RETENTION_MODE=report
RIZPOINT_RELEASE_SHA=development
RIZPOINT_ERROR_TRACKING_WEBHOOK_URL=
# Required outside the explicitly unauthenticated local demo. Keep server-side only.
RIZPOINT_PRIVATE_ACCESS_TOKEN=replace-with-private-access-token
# Leave blank for fixture-only local development. Never expose these in NEXT_PUBLIC_*.
# `sp_api` is the canonical live mode; the legacy `sp-api` spelling is accepted
# only for a safe migration. The worker alone receives live credentials.
PROVIDER_MODE=mock
SP_API_LWA_CLIENT_ID=
SP_API_LWA_CLIENT_SECRET=
# Server-side smoke/onboarding input only. Do not add it to compose.yaml or a
# browser .env file; the normal runtime stores it encrypted in PostgreSQL.
SP_API_REFRESH_TOKEN=
SP_API_MARKETPLACE_ID=ATVPDKIKX0DER
SP_API_SELLER_ID=
PROVIDER_CREDENTIAL_KEY_V1=
SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
# Opt-in only; CI never sets this. It performs one read-only Sellers API probe.
SP_API_LIVE_SMOKE=0
# Optional licensed market history. `mock` uses recorded deterministic fixtures.
# `keepa` is enabled only after an operator stores `keepa` / `api_key` as an
# encrypted ProviderCredential; do not put a Keepa API key in this file.
MARKET_HISTORY_PROVIDER_MODE=mock
KEEPA_API_ENDPOINT=https://api.keepa.com
# Required only for live Keepa mode. Set a conservative licensed-plan estimate;
# outbound calls stay blocked until a tenant-scoped TOKEN budget also exists.
KEEPA_HISTORY_TOKEN_ESTIMATE_PER_ASIN=
