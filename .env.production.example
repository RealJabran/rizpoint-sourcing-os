# Secret-manager references or placeholder values only. Do not copy this into Git as .env.production.
NODE_ENV=production
RIZPOINT_PRIVATE_MODE=true
PHASE_ZERO_DEMO_MODE=false
RIZPOINT_PRIVATE_ORGANIZATION_SLUG=replace-with-private-organization-slug
NEXTAUTH_URL=https://replace-with-private-domain
NEXTAUTH_SECRET=replace-with-32-or-more-random-server-side-characters
DATABASE_URL=replace-with-managed-postgresql-tls-url
REDIS_URL=replace-with-managed-redis-tls-url
S3_ENDPOINT=https://replace-with-private-s3-endpoint
# Browser-signed upload/download origin. This is not a bucket or credential value.
S3_PUBLIC_ENDPOINT=https://replace-with-private-s3-public-endpoint
S3_BUCKET=replace-with-private-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-least-privilege-access-key
S3_SECRET_KEY=replace-with-least-privilege-secret-key
S3_SERVER_SIDE_ENCRYPTION=aws:kms
S3_KMS_KEY_ID=replace-with-private-kms-key-id
S3_VERSIONING_ENABLED=true
S3_LIFECYCLE_MANAGED=true
MALWARE_SCAN_MODE=clamav
CLAMAV_HOST=replace-with-private-clamav-host
SCANNER_BASE_URL=http://scanner:8000
PROVIDER_CREDENTIAL_KEY_V1=replace-with-base64-32-byte-key
RIZPOINT_RETENTION_MODE=report
RIZPOINT_RELEASE_SHA=replace-with-immutable-release-sha
RIZPOINT_ERROR_TRACKING_WEBHOOK_URL=https://replace-with-private-error-tracking-collector
