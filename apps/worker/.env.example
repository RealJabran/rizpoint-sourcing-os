DATABASE_URL=postgresql://rizpoint:replace-with-local-password@localhost:5432/rizpoint?schema=public
# Optional, reviewed provider-cache overrides. Defaults and rationale are in
# docs/PROVIDER_RESEARCH_MEMORY.md. Retention must cover fresh + stale seconds.
# RIZPOINT_CACHE_COMPETITIVE_OFFERS_FRESH_SECONDS=900
# RIZPOINT_CACHE_COMPETITIVE_OFFERS_STALE_SECONDS=2700
# RIZPOINT_CACHE_COMPETITIVE_OFFERS_RETAIN_SECONDS=2592000
REDIS_URL=redis://localhost:6379
SCANNER_BASE_URL=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rizpoint-private
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=
S3_VERSIONING_ENABLED=false
S3_LIFECYCLE_MANAGED=false
RIZPOINT_RETENTION_MODE=report
RIZPOINT_RELEASE_SHA=development
RIZPOINT_ERROR_TRACKING_WEBHOOK_URL=
