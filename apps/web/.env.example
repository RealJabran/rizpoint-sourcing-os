DATABASE_URL=postgresql://rizpoint:replace-with-local-password@localhost:5432/rizpoint?schema=public
REDIS_URL=redis://localhost:6379
SCANNER_BASE_URL=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=rizpoint-private
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=
S3_VERSIONING_ENABLED=false
S3_LIFECYCLE_MANAGED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
RIZPOINT_PRIVATE_ACCESS_TOKEN=replace-with-private-access-token
PHASE_ZERO_DEMO_MODE=true
RIZPOINT_ALLOW_UNAUTHENTICATED_DEMO=true
RIZPOINT_PRIVATE_MODE=false
RIZPOINT_PRIVATE_ORGANIZATION_SLUG=rizpoint-private
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-server-side-characters
MALWARE_SCAN_MODE=clamav
