DATABASE_URL=postgresql://rizpoint:replace-with-local-password@localhost:5432/rizpoint?schema=public
MFA_CREDENTIAL_KEY_V1=replace-with-base64-encoded-32-byte-secret
REDIS_URL=redis://localhost:6379
SCANNER_BASE_URL=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=rizpoint-private
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=
S3_VERSIONING_ENABLED=false
S3_LIFECYCLE_MANAGED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
RIZPOINT_PRIVATE_ACCESS_TOKEN=replace-with-private-access-token
PHASE_ZERO_DEMO_MODE=true
RIZPOINT_ALLOW_UNAUTHENTICATED_DEMO=true
RIZPOINT_PRIVATE_MODE=false
RIZPOINT_PRIVATE_ORGANIZATION_SLUG=rizpoint-private
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-server-side-characters
MALWARE_SCAN_MODE=clamav
# Browser-facing development stays mock-first. Never put SP-API credentials,
# refresh tokens, or encryption keys in this file or any NEXT_PUBLIC_* name.
PROVIDER_MODE=mock
# Non-secret public-application metadata. Never add the LWA client secret,
# refresh token, vault key, or OAuth callback private key to the web env.
SP_API_APPLICATION_ID=
SP_API_OAUTH_ENABLED=false
SP_API_OAUTH_REDIRECT_URI=http://localhost:3000/api/providers/amazon/oauth/callback
SP_API_OAUTH_CALLBACK_PUBLIC_KEY=
SP_API_OAUTH_CALLBACK_KEY_VERSION=1
SP_API_OAUTH_DRAFT=true
