{
  "manifest_version": 3,
  "name": "RizPoint Research Companion",
  "version": "0.1.0",
  "description": "Send Amazon URL and ASIN targets to your authorized RizPoint backend.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "https://www.amazon.ca/*"
  ],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": { "default_title": "Open RizPoint Research Companion" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.ca/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
