  keywordId        String   @map("keyword_id")
  catalogProductId String   @map("catalog_product_id")
  marketplaceId    String   @map("marketplace_id")
  cadenceMinutes   Int      @map("cadence_minutes")
  nextRunAt        DateTime? @map("next_run_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project ResearchProject? @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId, organizationId], references: [id, organizationId], onDelete: Restrict)
  catalogProduct CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Restrict)
  observations KeywordRankObservation[]
  @@unique([organizationId, marketplaceId, keywordId, catalogProductId])
  @@index([organizationId, nextRunAt])
  @@map("keyword_rank_tracks")
}

model KeywordRankObservation {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  trackId String @map("track_id")
  providerKey String @map("provider_key")
  observedAt DateTime @map("observed_at")
  organicRank Int? @map("organic_rank")
  sponsoredRank Int? @map("sponsored_rank")
  freshnessState ExternalFreshnessState @map("freshness_state")
  requestKey String @map("request_key")
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  track KeywordRankTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  @@unique([trackId, requestKey])
  @@index([organizationId, trackId, observedAt])
  @@map("keyword_rank_observations")
}

model AlertRule {
  id              String                @id @default(cuid())
  organizationId  String                @map("organization_id")
  projectId       String?               @map("project_id")
  marketplaceId   String                @map("marketplace_id")
  subjectType     HistoricalSubjectType @map("subject_type")
  subjectKey      String                @map("subject_key")
  metricKey       String                @map("metric_key")
  operator        AlertOperator
  threshold       Decimal?              @db.Decimal(30, 10)
  status          AlertRuleStatus       @default(ACTIVE)
  cooldownMinutes Int                   @default(60) @map("cooldown_minutes")
  lastEvaluatedAt DateTime?             @map("last_evaluated_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      ResearchProject? @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  events       AlertEvent[]

  @@unique([id, organizationId])
  @@index([organizationId, status, marketplaceId])
  @@index([projectId])
  @@map("alert_rules")
}

model AlertEvent {
  id                    String           @id @default(cuid())
  organizationId        String           @map("organization_id")
  alertRuleId           String           @map("alert_rule_id")
  dedupeKey             String           @map("dedupe_key")
  status                AlertEventStatus @default(OPEN)
  sourceObservationRefs Json             @map("source_observation_refs")
  observedAt            DateTime         @map("observed_at")
  triggeredAt           DateTime         @default(now()) @map("triggered_at")
  acknowledgedAt        DateTime?        @map("acknowledged_at")
  resolvedAt            DateTime?        @map("resolved_at")
  payload               Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  alertRule    AlertRule    @relation(fields: [alertRuleId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([alertRuleId, dedupeKey])
  @@index([organizationId, status, triggeredAt])
  @@map("alert_events")
}
