  @@index([sourceObservationId])
  @@map("historical_metric_points")
}

/**
 * A versioned deterministic projection of normalized history. It is distinct
 * from raw provider observations and can be recalculated without mutation.
 */
model HistoryAnalyticsAssessment {
  id                   String                 @id @default(cuid())
  organizationId       String                 @map("organization_id")
  catalogProductId     String                 @map("catalog_product_id")
  marketplaceId        String                 @map("marketplace_id")
  providerKey          String                 @map("provider_key")
  calculationVersion   String                 @map("calculation_version")
  inputFingerprint     String                 @map("input_fingerprint")
  status               HistoryAnalyticsStatus
  windowStart          DateTime?              @map("window_start")
  windowEnd            DateTime               @map("window_end")
  coveragePercent      Decimal?               @map("coverage_percent") @db.Decimal(9, 4)
  metrics              Json
  warnings             String[]               @default([])
  inputPointReferences Json                   @map("input_point_references")
  calculatedAt         DateTime               @map("calculated_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  catalogProduct CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Restrict)

  @@unique([organizationId, catalogProductId, marketplaceId, providerKey, calculationVersion, inputFingerprint], map: "history_analytics_assessments_input_key")
  @@index([organizationId, catalogProductId, marketplaceId, calculatedAt], map: "history_analytics_assessments_org_product_calculated_idx")
  @@index([catalogProductId])
  @@map("history_analytics_assessments")
}

model OpportunityAssessment {
  id                         String                      @id @default(cuid())
  organizationId             String                      @map("organization_id")
  projectId                  String                      @map("project_id")
  projectItemId              String?                     @map("project_item_id")
  catalogProductId           String?                     @map("catalog_product_id")
  marketDefinitionId         String?                     @map("market_definition_id")
  marketplaceId              String                      @map("marketplace_id")
  status                     OpportunityAssessmentStatus
  recommendation             OpportunityRecommendation
  score                      Decimal?                    @db.Decimal(12, 4)
  calculationVersion         String                      @map("calculation_version")
  inputObservationReferences Json                        @map("input_observation_references")
  calculatedAt               DateTime                    @map("calculated_at")
  createdAt                  DateTime                    @default(now()) @map("created_at")

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project          ResearchProject      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  projectItem      ResearchProjectItem? @relation(fields: [projectItemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  catalogProduct   CatalogProduct?      @relation(fields: [catalogProductId], references: [id], onDelete: Restrict)
  marketDefinition MarketDefinition?    @relation(fields: [marketDefinitionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reasons          OpportunityReason[]

  @@unique([id, organizationId])
  @@index([organizationId, projectId, calculatedAt])
  @@index([organizationId, recommendation, calculatedAt])
  @@index([organizationId, catalogProductId, calculatedAt], map: "opportunity_assessments_org_product_calculated_idx")
  @@index([catalogProductId])
  @@index([marketDefinitionId])
  @@map("opportunity_assessments")
}

model OpportunityReason {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  assessmentId   String                @map("assessment_id")
  ordinal        Int
  code           String
  kind           OpportunityReasonKind
  message        String
  weight         Decimal?              @db.Decimal(12, 4)
  evidenceRefs   Json                  @map("evidence_refs")
  createdAt      DateTime              @default(now()) @map("created_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assessment   OpportunityAssessment @relation(fields: [assessmentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([assessmentId, ordinal])
  @@index([organizationId, assessmentId])
  @@map("opportunity_reasons")
}

/**
 * Immutable, deterministic niche score snapshot. The MarketDefinition holds
 * the source definition; each assessment preserves its thresholds and inputs.
 */
model NicheAssessment {
  id                      String                      @id @default(cuid())
  organizationId          String                      @map("organization_id")
  marketDefinitionId      String                      @map("market_definition_id")
  marketplaceId           String                      @map("marketplace_id")
  status                  OpportunityAssessmentStatus
  score                   Decimal?                    @db.Decimal(12, 4)
  confidencePercent       Decimal?                    @map("confidence_percent") @db.Decimal(9, 4)
  calculationVersion      String                      @map("calculation_version")
  inputFingerprint        String                      @map("input_fingerprint")
  thresholdConfiguration  Json                        @map("threshold_configuration")
  components              Json                        @map("components")
  inputEvidenceReferences Json                        @map("input_evidence_references")
  calculatedAt            DateTime                    @map("calculated_at")
  createdAt               DateTime                    @default(now()) @map("created_at")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  marketDefinition MarketDefinition @relation(fields: [marketDefinitionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, marketDefinitionId, calculationVersion, inputFingerprint], map: "niche_assessments_input_key")
  @@index([organizationId, marketplaceId, calculatedAt], map: "niche_assessments_org_market_calculated_idx")
  @@index([marketDefinitionId])
  @@map("niche_assessments")
}

