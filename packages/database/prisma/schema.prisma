  scenarioEffectiveCogs Decimal  @map("scenario_effective_cogs") @db.Decimal(18, 4)
  scenarioAmazonFee     Decimal  @map("scenario_amazon_fee") @db.Decimal(18, 4)
  scenarioNetProfit     Decimal  @map("scenario_net_profit") @db.Decimal(18, 4)
  supplierTotal         Decimal  @map("supplier_total") @db.Decimal(18, 4)
  landedCostTotal       Decimal  @map("landed_cost_total") @db.Decimal(18, 4)
  projectedRevenueTotal Decimal  @map("projected_revenue_total") @db.Decimal(18, 4)
  amazonFeeTotal        Decimal  @map("amazon_fee_total") @db.Decimal(18, 4)
  projectedProfitTotal  Decimal  @map("projected_profit_total") @db.Decimal(18, 4)
  sourceSnapshot        Json     @map("source_snapshot")
  warnings              Json     @default("[]")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  shortlistItem ShortlistItem @relation(fields: [shortlistItemId], references: [id], onDelete: Restrict)
  supplierRow   SupplierRow   @relation(fields: [supplierRowId], references: [id], onDelete: Restrict)
  profitResult  ProfitResult  @relation(fields: [profitResultId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, shortlistItemId])
  @@index([organizationId, purchaseOrderId])
  @@index([supplierRowId])
  @@map("purchase_order_lines")
}

model ExportJob {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  shortlistId      String?      @map("shortlist_id")
  purchaseOrderId  String?      @map("purchase_order_id")
  scanJobId        String?      @map("scan_job_id")
  kind             ExportKind
  format           ExportFormat
  status           ExportStatus @default(PENDING)
  sourceRevision   Int          @map("source_revision")
  queryState       Json?        @map("query_state")
  idempotencyKey   String       @map("idempotency_key")
  objectKey        String?      @unique @map("object_key")
  filename         String?      @map("filename")
  contentType      String?      @map("content_type")
  checksumSha256   String?      @map("checksum_sha256")
  byteSize         Int?         @map("byte_size")
  generatorVersion String?      @map("generator_version")
  attemptCount     Int          @default(0) @map("attempt_count")
  failureCode      String?      @map("failure_code")
  completedAt      DateTime?    @map("completed_at")
  expiresAt        DateTime?    @map("expires_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shortlist     Shortlist?     @relation(fields: [shortlistId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  scanJob       ScanJob?       @relation(fields: [scanJobId], references: [id], onDelete: Restrict)
  outboxEvents  OutboxEvent[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, scanJobId, createdAt])
  @@map("export_jobs")
}

model WorkflowAuditEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  eventType      String   @map("event_type")
  revision       Int?
  idempotencyKey String?  @map("idempotency_key")
  reason         String?
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, entityType, entityId, createdAt])
  @@map("workflow_audit_events")
}
