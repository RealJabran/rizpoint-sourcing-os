generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScanJobStatus {
  UPLOADED
  MAPPING_REQUIRED
  READY
  NORMALIZING
  MATCHING
  ENRICHING
  CALCULATING
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL_SUCCESS
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum UploadStatus {
  PENDING_UPLOAD
  QUARANTINED
  INSPECTING
  MAPPING_REQUIRED
  READY
  NORMALIZING
  COMPLETED
  REJECTED
}

enum MalwareScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum FileFormat {
  CSV
  XLS
  XLSX
}

enum MappingTarget {
  ASIN
  UPC
  EAN
  GTIN
  ITEM_NUMBER
  MPN
  DESCRIPTION
  BRAND
  UNIT_COST
  CURRENCY
  QUANTITY
  CASE_COUNT
  PACK_COUNT
  WEIGHT
  LENGTH
  WIDTH
  HEIGHT
}

enum NormalizationStatus {
  PENDING
  NORMALIZED
  WARNING
  INVALID
}

enum WarningSeverity {
  INFO
  WARNING
  ERROR
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
}

enum IdentifierType {
  ASIN
  UPC
  EAN
  GTIN
  MPN
}

enum CandidateSource {
  SUPPLIED_ASIN
  EXACT_IDENTIFIER
  MPN_BRAND
  TITLE_SEARCH
}

enum MatchDecisionStatus {
  AUTO_ACCEPTED
  REVIEW_REQUIRED
  UNMATCHED
  USER_ACCEPTED
  USER_REJECTED
}

enum MatchEvidenceFeature {
  IDENTIFIER
  BRAND
  MODEL
  SIZE
  PACK
  VARIATION
  TITLE
}

enum MatchEvidenceOutcome {
  AGREEMENT
  CONTRADICTION
  UNKNOWN
  NOT_APPLICABLE
}

enum DecisionSource {
  SYSTEM
  HUMAN
}

enum LookupStatus {
  COMPLETED
  FAILED
}

enum ExternalFreshnessState {
  FRESH
  STALE
  EXPIRED
  UNKNOWN
}

enum PackGuardStatus {
  VERIFIED
  BLOCKED_PACK_UNCERTAIN
  BLOCKED_PACK_CONTRADICTION
}

enum ProviderKind {
  AMAZON_SP_API
  MOCK_AMAZON
  MOCK_HISTORY
}

enum ProviderConnectionMode {
  MOCK
  SELF_AUTHORIZED
  OAUTH
}

enum ProviderConnectionStatus {
  PENDING
  ACTIVE
  AUTH_REQUIRED
  REVOKED
  ERROR
}

enum EnrichmentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL_SUCCESS
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum EnrichmentItemStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL_SUCCESS
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum EnrichmentMetricType {
  CATALOG
  PRICING
  FEES
  RESTRICTIONS
  HISTORY
}

enum ProviderAttemptStatus {
  SUCCESS
  RETRYABLE_ERROR
  PERMANENT_ERROR
  THROTTLED
}

enum ProviderObservationStatus {
  SUCCESS
  PARTIAL
  UNAUTHORIZED
  THROTTLED
  RETRYABLE_FAILURE
  TERMINAL_FAILURE
  UNAVAILABLE
}

enum OfferPresence {
  PRESENT
  ABSENT
  UNKNOWN
}

enum OfferCompleteness {
  COMPLETE
  PARTIAL
  UNKNOWN
}

enum OfferFulfillmentChannel {
  AMAZON
  MERCHANT
  UNKNOWN
}

enum FeeScenarioSource {
  CURRENT_FEATURED_OFFER
  CONSERVATIVE
  USER_ENTERED
}

enum ListingRestrictionState {
  ELIGIBLE
  RESTRICTED
  APPROVAL_REQUIRED
  INCOMPLETE
  UNAUTHORIZED
  THROTTLED
  UNKNOWN
}

enum BrandPolicyStatus {
  PROHIBITED
  APPROVAL_REQUIRED
  APPROVED
  UNRESTRICTED
}

enum ProfitCalculationStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL_SUCCESS
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum ProfitScenarioType {
  CURRENT
  CONSERVATIVE
  STRESS
  MAP
}

enum ProfitCalculationScope {
  FULL
  TARGETED
}

enum AnalysisOverrideStatus {
  PENDING_RECALCULATION
  APPLIED
  FAILED
}

enum CostOverrideField {
  SUPPLIER_COST_PER_SELLABLE_UNIT
  ALLOCATED_SUPPLIER_FREIGHT
  PREP_FEE
  LABELING_FEE
  POLYBAG_FEE
  BUNDLE_FEE
  BUBBLEWRAP_FEE
  INBOUND_SHIPPING
  DUTY_OR_TAX
  STORAGE_ALLOWANCE
  RETURN_ALLOWANCE
  OTHER_COSTS
}

enum ProductRecommendation {
  BUY
  WATCH
  REVIEW_MATCH
  REVIEW_APPROVAL
  REVIEW_COST
  AVOID
  INSUFFICIENT_DATA
}

enum ShortlistStatus {
  ACTIVE
  ARCHIVED
}

enum ShortlistItemStatus {
  RESEARCH
  REVIEW
  READY_FOR_PO
  ON_HOLD
  REJECTED
  ORDERED
}

enum PurchaseOrderStatus {
  DRAFT
  VALIDATED
  EXPORTED
  CANCELLED
}

enum ExportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum ExportFormat {
  CSV
  XLSX
}

enum ExportKind {
  SHORTLIST
  PURCHASE_ORDER
  AUDIT_REPORT
  ANALYSIS_VIEW
}

enum OrganizationRole {
  OWNER
}

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  scanJobs                    ScanJob[]
  outbox                      OutboxEvent[]
  suppliers                   Supplier[]
  uploads                     Upload[]
  sheetProfiles               SheetProfile[]
  matchLookups                MatchLookup[]
  listingCandidates           ListingCandidate[]
  matchDecisions              MatchDecision[]
  providerConnections         ProviderConnection[]
  providerAuthorizationStates ProviderAuthorizationState[]
  enrichmentRuns              EnrichmentRun[]
  providerCallAttempts        ProviderCallAttempt[]
  financialPolicy             FinancialPolicy?
  shippingRoutes              ShippingRoute[]
  brandPolicies               BrandPolicy[]
  profitCalculationRuns       ProfitCalculationRun[]
  profitResults               ProfitResult[]
  analysisViews               AnalysisView[]
  profitCostOverrides         ProfitCostOverride[]
  profitCostOverrideEvents    ProfitCostOverrideEvent[]
  shortlists                  Shortlist[]
  shortlistItems              ShortlistItem[]
  shortlistNotes              ShortlistNote[]
  purchaseOrders              PurchaseOrder[]
  purchaseOrderLines          PurchaseOrderLine[]
  exportJobs                  ExportJob[]
  workflowAuditEvents         WorkflowAuditEvent[]
  memberships                 OrganizationMembership[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String?
  passwordHash String   @map("password_hash")
  active       Boolean  @default(true)
  sessionEpoch Int      @default(0) @map("session_epoch")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships OrganizationMembership[]

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole @default(OWNER)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, organizationId])
  @@map("organization_memberships")
}

model ScanJob {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  idempotencyKey String        @map("idempotency_key")
  supplierId     String?       @map("supplier_id")
  uploadId       String?       @unique @map("upload_id")
  jobType        String        @default("MOCK") @map("job_type")
  status         ScanJobStatus @default(QUEUED)
  attemptCount   Int           @default(0) @map("attempt_count")
  mockResult     Json?         @map("mock_result")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  completedAt    DateTime?     @map("completed_at")

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier              Supplier?              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  upload                Upload?                @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  checkpoints           ScanCheckpoint[]
  events                ScanEvent[]
  outboxEvents          OutboxEvent[]
  columnMappings        ColumnMapping[]
  supplierRows          SupplierRow[]
  matchLookups          MatchLookup[]
  enrichmentRuns        EnrichmentRun[]
  profitCalculationRuns ProfitCalculationRun[]
  profitResults         ProfitResult[]
  analysisViews         AnalysisView[]
  profitCostOverrides   ProfitCostOverride[]
  exportJobs            ExportJob[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
  @@map("scan_jobs")
}

model Supplier {
  id                      String    @id @default(cuid())
  organizationId          String    @map("organization_id")
  code                    String
  name                    String
  isVsiPreset             Boolean   @default(false) @map("is_vsi_preset")
  minimumOrderCases       Int       @default(1) @map("minimum_order_cases")
  orderMultipleCases      Int       @default(1) @map("order_multiple_cases")
  minimumOrderAmount      Decimal?  @map("minimum_order_amount") @db.Decimal(18, 4)
  orderingRulesSource     String?   @map("ordering_rules_source")
  orderingRulesObservedAt DateTime? @map("ordering_rules_observed_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploads        Upload[]
  scans          ScanJob[]
  sheetProfiles  SheetProfile[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@map("suppliers")
}

model Upload {
  id                String            @id @default(cuid())
  organizationId    String            @map("organization_id")
  supplierId        String            @map("supplier_id")
  originalFilename  String            @map("original_filename")
  objectKey         String            @unique @map("object_key")
  declaredMediaType String?           @map("declared_media_type")
  detectedFormat    FileFormat?       @map("detected_format")
  byteSize          Int?              @map("byte_size")
  checksumSha256    String?           @map("checksum_sha256")
  status            UploadStatus      @default(PENDING_UPLOAD)
  malwareStatus     MalwareScanStatus @default(PENDING) @map("malware_status")
  rejectionCode     String?           @map("rejection_code")
  inspectedAt       DateTime?         @map("inspected_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sheets       UploadSheet[]
  scan         ScanJob?

  @@index([organizationId, status])
  @@index([supplierId, createdAt])
  @@map("uploads")
}

model UploadSheet {
  id                String   @id @default(cuid())
  uploadId          String   @map("upload_id")
  sheetIndex        Int      @map("sheet_index")
  name              String
  rowCount          Int      @map("row_count")
  columnCount       Int      @map("column_count")
  headerCandidates  Json     @map("header_candidates")
  selectedHeaderRow Int?     @map("selected_header_row")
  columns           Json
  preview           Json
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  upload       Upload        @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  supplierRows SupplierRow[]

  @@unique([uploadId, sheetIndex])
  @@map("upload_sheets")
}

model SheetProfile {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  supplierId     String      @map("supplier_id")
  name           String
  fileFormat     FileFormat? @map("file_format")
  sheetName      String?     @map("sheet_name")
  headerRow      Int         @map("header_row")
  mapping        Json
  version        Int         @default(1)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([supplierId, name])
  @@map("sheet_profiles")
}

model ColumnMapping {
  id           String        @id @default(cuid())
  scanJobId    String        @map("scan_job_id")
  sourceIndex  Int           @map("source_index")
  sourceColumn String        @map("source_column")
  target       MappingTarget
  required     Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")

  scanJob ScanJob @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  @@unique([scanJobId, target])
  @@unique([scanJobId, sourceIndex])
  @@map("column_mappings")
}

model SupplierRow {
  id                  String              @id @default(cuid())
  scanJobId           String              @map("scan_job_id")
  uploadSheetId       String              @map("upload_sheet_id")
  sourceRowNumber     Int                 @map("source_row_number")
  rawData             Json                @map("raw_data")
  rowChecksum         String              @map("row_checksum")
  normalizationStatus NormalizationStatus @default(PENDING) @map("normalization_status")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  scanJob                  ScanJob                   @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  uploadSheet              UploadSheet               @relation(fields: [uploadSheetId], references: [id], onDelete: Restrict)
  normalizedOffer          NormalizedOffer?
  warnings                 NormalizationWarning[]
  listingCandidates        ListingCandidate[]
  matchDecision            MatchDecision?
  enrichmentItems          EnrichmentItem[]
  profitResults            ProfitResult[]
  profitCostOverrides      ProfitCostOverride[]
  profitCalculationTargets ProfitCalculationTarget[]
  shortlistItems           ShortlistItem[]
  purchaseOrderLines       PurchaseOrderLine[]

  @@unique([scanJobId, sourceRowNumber])
  @@index([scanJobId, normalizationStatus])
  @@map("supplier_rows")
}

model NormalizedOffer {
  id            String   @id @default(cuid())
  supplierRowId String   @unique @map("supplier_row_id")
  asin          String?
  upc           String?
  ean           String?
  gtin          String?
  itemNumber    String?  @map("item_number")
  mpn           String?
  description   String?
  brand         String?
  unitCost      Decimal? @map("unit_cost") @db.Decimal(18, 4)
  currency      String?
  quantity      Int?
  caseCount     Int?     @map("case_count")
  packCount     Int?     @map("pack_count")
  weight        Decimal? @db.Decimal(18, 4)
  length        Decimal? @db.Decimal(18, 4)
  width         Decimal? @db.Decimal(18, 4)
  height        Decimal? @db.Decimal(18, 4)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  supplierRow SupplierRow @relation(fields: [supplierRowId], references: [id], onDelete: Cascade)

  @@index([upc])
  @@index([ean])
  @@map("normalized_offers")
}

model NormalizationWarning {
  id            String          @id @default(cuid())
  supplierRowId String          @map("supplier_row_id")
  code          String
  severity      WarningSeverity
  field         String?
  context       Json?
  createdAt     DateTime        @default(now()) @map("created_at")

  supplierRow SupplierRow @relation(fields: [supplierRowId], references: [id], onDelete: Cascade)

  @@unique([supplierRowId, code, field])
  @@map("normalization_warnings")
}

model CatalogProduct {
  id                   String                 @id @default(cuid())
  provider             String
  providerReference    String                 @map("provider_reference")
  asin                 String?
  title                String
  brand                String?
  model                String?
  mpn                  String?
  sizeText             String?                @map("size_text")
  packCount            Int?                   @map("pack_count")
  variation            String?
  marketplaceId        String?                @map("marketplace_id")
  responseCompleteness String?                @map("response_completeness")
  requestLineage       String?                @map("request_lineage")
  identityProjection   Json?                  @map("identity_projection")
  observedAt           DateTime               @map("observed_at")
  freshnessState       ExternalFreshnessState @map("freshness_state")
  rawPayload           Json?                  @map("raw_payload")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  identifiers       ProductIdentifier[]
  listingCandidates ListingCandidate[]

  @@unique([provider, providerReference])
  @@index([provider, asin])
  @@map("catalog_products")
}

model ProductIdentifier {
  id               String         @id @default(cuid())
  catalogProductId String         @map("catalog_product_id")
  type             IdentifierType
  value            String
  createdAt        DateTime       @default(now()) @map("created_at")

  catalogProduct CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)

  @@unique([catalogProductId, type, value])
  @@index([type, value])
  @@map("product_identifiers")
}

model MatchLookup {
  id               String                  @id @default(cuid())
  organizationId   String                  @map("organization_id")
  scanJobId        String                  @map("scan_job_id")
  provider         String
  lookupType       CandidateSource         @map("lookup_type")
  lookupKey        String                  @map("lookup_key")
  status           LookupStatus
  responseChecksum String?                 @map("response_checksum")
  payload          Json?
  observedAt       DateTime?               @map("observed_at")
  freshnessState   ExternalFreshnessState? @map("freshness_state")
  errorCode        String?                 @map("error_code")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scan         ScanJob      @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  @@unique([scanJobId, provider, lookupType, lookupKey])
  @@index([organizationId, scanJobId])
  @@map("match_lookups")
}

model ListingCandidate {
  id               String          @id @default(cuid())
  organizationId   String          @map("organization_id")
  supplierRowId    String          @map("supplier_row_id")
  catalogProductId String          @map("catalog_product_id")
  source           CandidateSource
  confidence       Int
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplierRow          SupplierRow      @relation(fields: [supplierRowId], references: [id], onDelete: Cascade)
  catalogProduct       CatalogProduct   @relation(fields: [catalogProductId], references: [id], onDelete: Restrict)
  evidence             MatchEvidence[]
  selectedForDecisions MatchDecision[]  @relation("selected_candidate")
  packGuard            PackGuardResult?

  @@unique([supplierRowId, catalogProductId, source])
  @@index([organizationId, supplierRowId])
  @@map("listing_candidates")
}

model MatchEvidence {
  id                 String               @id @default(cuid())
  listingCandidateId String               @map("listing_candidate_id")
  feature            MatchEvidenceFeature
  outcome            MatchEvidenceOutcome
  score              Int
  reasonCode         String               @map("reason_code")
  details            Json?
  createdAt          DateTime             @default(now()) @map("created_at")

  listingCandidate ListingCandidate @relation(fields: [listingCandidateId], references: [id], onDelete: Cascade)

  @@unique([listingCandidateId, feature])
  @@map("match_evidence")
}

model MatchDecision {
  id                  String              @id @default(cuid())
  organizationId      String              @map("organization_id")
  supplierRowId       String              @unique @map("supplier_row_id")
  selectedCandidateId String?             @map("selected_candidate_id")
  status              MatchDecisionStatus
  confidence          Int
  reasonCodes         Json                @map("reason_codes")
  source              DecisionSource
  reviewedAt          DateTime?           @map("reviewed_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplierRow       SupplierRow       @relation(fields: [supplierRowId], references: [id], onDelete: Cascade)
  selectedCandidate ListingCandidate? @relation("selected_candidate", fields: [selectedCandidateId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, updatedAt])
  @@map("match_decisions")
}

model PackGuardResult {
  id                   String          @id @default(cuid())
  listingCandidateId   String          @unique @map("listing_candidate_id")
  status               PackGuardStatus
  supplierUnitsPerCase Int?            @map("supplier_units_per_case")
  amazonUnitsPerPack   Int?            @map("amazon_units_per_pack")
  sellableUnitsPerCase Int?            @map("sellable_units_per_case")
  remainderUnits       Int?            @map("remainder_units")
  costPerSellableUnit  Decimal?        @map("cost_per_sellable_unit") @db.Decimal(18, 4)
  reasonCode           String          @map("reason_code")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  listingCandidate ListingCandidate @relation(fields: [listingCandidateId], references: [id], onDelete: Cascade)

  @@map("pack_guard_results")
}

model ProviderConnection {
  id                    String                   @id @default(cuid())
  organizationId        String                   @map("organization_id")
  provider              ProviderKind
  mode                  ProviderConnectionMode
  status                ProviderConnectionStatus @default(PENDING)
  sellerId              String?                  @map("seller_id")
  marketplaceId         String                   @map("marketplace_id")
  region                String
  encryptedRefreshToken String?                  @map("encrypted_refresh_token")
  encryptionNonce       String?                  @map("encryption_nonce")
  encryptionTag         String?                  @map("encryption_tag")
  encryptionKeyVersion  Int?                     @map("encryption_key_version")
  authorizedAt          DateTime?                @map("authorized_at")
  lastValidatedAt       DateTime?                @map("last_validated_at")
  lastSuccessAt         DateTime?                @map("last_success_at")
  lastErrorCode         String?                  @map("last_error_code")
  revokedAt             DateTime?                @map("revoked_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  authorizationStates ProviderAuthorizationState[]
  enrichmentRuns      EnrichmentRun[]

  @@unique([organizationId, provider, marketplaceId])
  @@index([organizationId, status])
  @@map("provider_connections")
}

model ProviderAuthorizationState {
  id                   String       @id @default(cuid())
  organizationId       String       @map("organization_id")
  providerConnectionId String?      @map("provider_connection_id")
  provider             ProviderKind
  stateHash            String       @unique @map("state_hash")
  marketplaceId        String       @map("marketplace_id")
  region               String
  returnPath           String       @map("return_path")
  expiresAt            DateTime     @map("expires_at")
  consumedAt           DateTime?    @map("consumed_at")
  createdAt            DateTime     @default(now()) @map("created_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  providerConnection ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@map("provider_authorization_states")
}

model EnrichmentRun {
  id                   String              @id @default(cuid())
  organizationId       String              @map("organization_id")
  scanJobId            String              @map("scan_job_id")
  providerConnectionId String?             @map("provider_connection_id")
  status               EnrichmentRunStatus @default(PENDING)
  attemptCount         Int                 @default(0) @map("attempt_count")
  missingMetricCount   Int                 @default(0) @map("missing_metric_count")
  completedAt          DateTime?           @map("completed_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scanJob              ScanJob               @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection?   @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)
  items                EnrichmentItem[]
