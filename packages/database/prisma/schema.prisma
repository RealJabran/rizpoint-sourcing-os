generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScanJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
}

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  scanJobs ScanJob[]
  outbox   OutboxEvent[]

  @@map("organizations")
}

model ScanJob {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  idempotencyKey String        @map("idempotency_key")
  status         ScanJobStatus @default(QUEUED)
  attemptCount   Int           @default(0) @map("attempt_count")
  mockResult     Json?         @map("mock_result")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  completedAt    DateTime?     @map("completed_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  checkpoints  ScanCheckpoint[]
  events       ScanEvent[]
  outboxEvents OutboxEvent[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@map("scan_jobs")
}

model ScanCheckpoint {
  id        String   @id @default(cuid())
  scanJobId String   @map("scan_job_id")
  stage     String
  checksum  String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  scanJob ScanJob @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  @@unique([scanJobId, stage])
  @@map("scan_checkpoints")
}

model ScanEvent {
  id        String   @id @default(cuid())
  scanJobId String   @map("scan_job_id")
  eventType String   @map("event_type")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  scanJob ScanJob @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  @@index([scanJobId, createdAt])
  @@map("scan_events")
}

model OutboxEvent {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  scanJobId      String      @map("scan_job_id")
  eventType      String      @map("event_type")
  payload        Json
  status         OutboxStatus @default(PENDING)
  claimToken     String?     @map("claim_token")
  claimedAt      DateTime?   @map("claimed_at")
  deliveryAttempts Int       @default(0) @map("delivery_attempts")
  lastError      String?     @map("last_error")
  publishedAt    DateTime?   @map("published_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scanJob      ScanJob      @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  @@unique([scanJobId, eventType])
  @@index([status, claimedAt, createdAt])
  @@map("outbox_events")
}
