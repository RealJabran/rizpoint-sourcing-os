  initialCashRequired       Decimal?                 @map("initial_cash_required") @db.Decimal(20, 4)
  moqCashExposure           Decimal?                 @map("moq_cash_exposure") @db.Decimal(20, 4)
  waterfall                 Json
  uncertainCosts            Json                     @map("uncertain_costs")
  reasonCodes               Json                     @map("reason_codes")
  inputSnapshot             Json                     @map("input_snapshot")
  calculatedAt              DateTime                 @map("calculated_at")
  createdAt                 DateTime                 @default(now()) @map("created_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scenario     PrivateLabelQuoteScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, kind, stressName])
  @@index([organizationId, scenarioId, calculatedAt])
  @@map("private_label_scenario_results")
}

/// Versioned, tenant-scoped source material used for research-stage screening.
/// A ruleset is never a legal conclusion; its source and effective date are
/// persisted so users can independently verify it.
model ComplianceRuleSet {
  id                String                  @id @default(cuid())
  organizationId    String                  @map("organization_id")
  marketplaceId     String                  @map("marketplace_id")
  jurisdiction      String
  name              String
  version           String
  sourceTitle       String                  @map("source_title")
  sourceUrl         String                  @map("source_url")
  sourcePublishedAt DateTime                @map("source_published_at")
  sourceAccessedAt  DateTime                @map("source_accessed_at")
  status            ComplianceRuleSetStatus @default(ACTIVE)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rules        ComplianceRule[]
  assessments  ComplianceRiskAssessment[]

  @@unique([organizationId, marketplaceId, jurisdiction, version])
  @@index([organizationId, marketplaceId, jurisdiction, status, updatedAt])
  @@map("compliance_rule_sets")
}

/// A curated screening rule. LOW may only be used when its saved source is an
/// authoritative clearance; the repository enforces that invariant.
model ComplianceRule {
  id                     String               @id @default(cuid())
  ruleSetId              String               @map("rule_set_id")
  domain                 ComplianceRiskDomain
  riskLevel              ComplianceRiskLevel  @map("risk_level")
  matchTerms             Json                 @map("match_terms")
  rationale              String
  supplierQuestions      Json                 @map("supplier_questions")
  likelyDocumentation    Json                 @map("likely_documentation")
  authoritativeClearance Boolean              @default(false) @map("authoritative_clearance")
  ruleSourceTitle        String               @map("rule_source_title")
  ruleSourceUrl          String               @map("rule_source_url")
  ruleSourcePublishedAt  DateTime             @map("rule_source_published_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  ruleSet ComplianceRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@unique([ruleSetId, domain])
  @@index([ruleSetId, domain])
  @@map("compliance_rules")
}

/// Immutable deterministic research-screening result. The input evidence and
/// exact ruleset version remain with the result for audit/replay.
model ComplianceRiskAssessment {
  id                      String   @id @default(cuid())
  organizationId          String   @map("organization_id")
  projectId               String   @map("project_id")
  catalogProductId        String?  @map("catalog_product_id")
  ruleSetId               String   @map("rule_set_id")
  marketplaceId           String   @map("marketplace_id")
  jurisdiction            String
  inputText               String   @map("input_text")
  inputFingerprint        String   @map("input_fingerprint")
  results                 Json
  inputEvidenceReferences Json     @map("input_evidence_references")
  calculatedAt            DateTime @map("calculated_at")
  createdAt               DateTime @default(now()) @map("created_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        ResearchProject   @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  catalogProduct CatalogProduct?   @relation(fields: [catalogProductId], references: [id], onDelete: Restrict)
  ruleSet        ComplianceRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)

  @@unique([organizationId, projectId, ruleSetId, inputFingerprint])
  @@index([organizationId, projectId, calculatedAt])
  @@index([organizationId, catalogProductId, calculatedAt])
  @@map("compliance_risk_assessments")
}

/// Immutable input snapshot and solver outcome for one project portfolio run.
model PortfolioOptimizationRun {
  id                String                      @id @default(cuid())
  organizationId    String                      @map("organization_id")
  projectId         String                      @map("project_id")
  name              String
  status            PortfolioOptimizationStatus
  solverVersion     String                      @map("solver_version")
  inputHash         String                      @map("input_hash")
  currency          String
  cashBudget        Decimal                     @map("cash_budget") @db.Decimal(20, 4)
  constraints       Json
  stressAssumptions Json                        @map("stress_assumptions")
  inputSnapshot     Json                        @map("input_snapshot")
  reasonCodes       Json                        @map("reason_codes")
  calculatedAt      DateTime                    @map("calculated_at")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      ResearchProject               @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  results      PortfolioOptimizationResult[]

  @@unique([id, organizationId])
  @@unique([organizationId, projectId, inputHash])
  @@index([organizationId, projectId, calculatedAt])
  @@map("portfolio_optimization_runs")
}

/// One recommended or alternative portfolio for one named stress scenario.
/// Failure scenarios persist rank zero with no financial output/allocation.
model PortfolioOptimizationResult {
  id                   String                        @id @default(cuid())
  organizationId       String                        @map("organization_id")
  runId                String                        @map("run_id")
  scenario             PortfolioOptimizationScenario
  rank                 Int
  status               PortfolioOptimizationStatus
  exactOptimal         Boolean                       @map("exact_optimal")
  searchNodes          Int                           @map("search_nodes")
  cashUsed             Decimal?                      @map("cash_used") @db.Decimal(20, 4)
  cashRemaining        Decimal?                      @map("cash_remaining") @db.Decimal(20, 4)
  expectedProfitLow    Decimal?                      @map("expected_profit_low") @db.Decimal(20, 4)
  expectedProfitHigh   Decimal?                      @map("expected_profit_high") @db.Decimal(20, 4)
  productCount         Int?                          @map("product_count")
  diversificationScore Decimal?                      @map("diversification_score") @db.Decimal(12, 4)
  riskConcentration    Json                          @map("risk_concentration")
  constraintAudit      Json                          @map("constraint_audit")
  excludedProducts     Json                          @map("excluded_products")
  assumptions          Json
  reasonCodes          Json                          @map("reason_codes")
  createdAt            DateTime                      @default(now()) @map("created_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  run          PortfolioOptimizationRun @relation(fields: [runId, organizationId], references: [id, organizationId], onDelete: Cascade)
  allocations  PortfolioAllocation[]

  @@unique([id, organizationId])
  @@unique([runId, scenario, rank])
  @@index([organizationId, runId, scenario, rank])
  @@map("portfolio_optimization_results")
}

model PortfolioAllocation {
  id                    String   @id @default(cuid())
