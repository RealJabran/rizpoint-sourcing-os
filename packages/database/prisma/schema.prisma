model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  firstName           String?   @map("first_name")
  lastName            String?   @map("last_name")
  displayName         String?   @map("display_name")
  passwordHash        String    @map("password_hash")
  passwordChangedAt   DateTime  @default(now()) @map("password_changed_at")
  passwordExpiresAt   DateTime  @map("password_expires_at")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  active              Boolean   @default(true)
  deactivatedAt       DateTime? @map("deactivated_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at")
  lockedUntil         DateTime? @map("locked_until")
  lastAuthenticatedAt DateTime? @map("last_authenticated_at")
  sessionEpoch        Int       @default(0) @map("session_epoch")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  memberships              OrganizationMembership[]
  passwordHistory          UserPasswordHistory[]
  mfaFactor                UserMfaFactor?
  authenticationChallenges AuthenticationChallenge[]
  sessions                 UserSession[]
  accessReviewsSubject     OrganizationAccessReview[] @relation("AccessReviewSubject")
  accessReviewsReviewer    OrganizationAccessReview[] @relation("AccessReviewReviewer")
  securityEventsActor      SecurityAuditEvent[]       @relation("SecurityEventActor")
  securityEventsTarget     SecurityAuditEvent[]       @relation("SecurityEventTarget")
  credentialRotations      CredentialRotationRecord[] @relation("CredentialRotationActor")

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole @default(OWNER)
  active         Boolean          @default(true)
  deactivatedAt  DateTime?        @map("deactivated_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user          User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  accessReviews OrganizationAccessReview[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([userId, organizationId])
  @@map("organization_memberships")
}

model UserPasswordHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  passwordHash String   @map("password_hash")
  usedAt       DateTime @default(now()) @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt(sort: Desc)])
  @@map("user_password_history")
}

model UserMfaFactor {
  id                   String    @id @default(cuid())
  userId               String    @unique @map("user_id")
  encryptedSecret      String    @map("encrypted_secret")
  encryptionNonce      String    @map("encryption_nonce")
  encryptionTag        String    @map("encryption_tag")
  encryptionKeyVersion Int       @map("encryption_key_version")
  confirmedAt          DateTime? @map("confirmed_at")
  disabledAt           DateTime? @map("disabled_at")
  lastUsedAt           DateTime? @map("last_used_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes UserMfaRecoveryCode[]

  @@map("user_mfa_factors")
}

model UserMfaRecoveryCode {
  id        String    @id @default(cuid())
  factorId  String    @map("factor_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  factor UserMfaFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)

  @@index([factorId, usedAt])
  @@map("user_mfa_recovery_codes")
}

model AuthenticationChallenge {
  id             String                         @id @default(cuid())
  organizationId String                         @map("organization_id")
  userId         String                         @map("user_id")
  tokenHash      String                         @unique @map("token_hash")
  purpose        AuthenticationChallengePurpose
  failedAttempts Int                            @default(0) @map("failed_attempts")
  expiresAt      DateTime                       @map("expires_at")
  consumedAt     DateTime?                      @map("consumed_at")
  createdAt      DateTime                       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, purpose, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("authentication_challenges")
}

model UserSession {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  sessionEpoch   Int       @map("session_epoch")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  revokedReason  String?   @map("revoked_reason")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([userId, revokedAt, expiresAt])
  @@index([organizationId, lastSeenAt])
  @@map("user_sessions")
}

model OrganizationAccessReview {
  id              String               @id @default(cuid())
  organizationId  String               @map("organization_id")
  membershipId    String               @map("membership_id")
  subjectUserId   String               @map("subject_user_id")
  reviewerUserId  String               @map("reviewer_user_id")
  decision        AccessReviewDecision
  reviewedRole    OrganizationRole     @map("reviewed_role")
  requestedRole   OrganizationRole?    @map("requested_role")
  reason          String
  reviewedAt      DateTime             @default(now()) @map("reviewed_at")
  nextReviewDueAt DateTime             @map("next_review_due_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  subjectUser  User                   @relation("AccessReviewSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  reviewerUser User                   @relation("AccessReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, subjectUserId, reviewedAt(sort: Desc)])
  @@index([organizationId, nextReviewDueAt])
  @@map("organization_access_reviews")
}

model SecurityAuditEvent {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  actorUserId    String?                @map("actor_user_id")
  targetUserId   String?                @map("target_user_id")
